   <property name="styleSheet">
    <string notr="true">QPushButton {
    background-color: #E0E0E0;      /* 背景より少し濃いグレー */
    color: #000000;                 /* 黒字 */
    border: 1px solid #B8B8B8;      /* 薄いグレーの枠線 */
    border-radius: 0px;             /* 角丸なし */
}

QPushButton:hover {
    background-color: #D0D0D0;      /* ホバー：少し濃いグレー */
    color: #000000;                 /* 黒字のまま */
}

QPushButton:pressed {
    background-color: #C0C0C0;      /* 押下：さらに濃いグレー */
    color: #000000;                 /* 黒字のまま */
}
</string>
   </property>
